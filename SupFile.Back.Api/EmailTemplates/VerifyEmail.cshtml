@model SupFile.Back.Business.Models.Templates.Emails.VerificationEmailModel

<!DOCTYPE html>
<html>
<body
    style="font-family: Arial, sans-serif; max-width: 600px; margin: auto; padding: 30px; border: 1px solid #ccc; line-height: 1.6;">

@* Logo *@
@if (!string.IsNullOrEmpty(Model.AppSettings.LogoUrl))
{
    <div style="text-align:center; margin-bottom: 30px;">
        <img src="@Model.AppSettings.LogoUrl" alt="@Model.AppSettings.Name" style="max-width:48px; height:auto;"/>
    </div>
}

<p style="margin-bottom: 25px;">Hello @Model.UserName,</p>

<p style="margin-bottom: 25px;">Thank you for registering with @Model.AppSettings.Name. Please click the button below to
    verify your email address:</p>

<a href="@Model.VerificationLink"
   style="padding:12px 20px;background:#000;color:#fff;text-decoration:none;">
    Reset your password
</a>


<p style="margin-top: 30px; margin-bottom: 10px;">Alternatively, you can use the verification code below:</p>

@if (!string.IsNullOrEmpty(Model.Token))
{
    <table align="center" cellpadding="0" cellspacing="0" style="margin: 25px auto;">
        <tr>
            @foreach (var c in Model.Token)
            {
                <td style="
                    border: 1px solid #ccc;
                    padding: 10px 12px;
                    font-size: 18px;
                    font-weight: bold;
                    text-align: center;
                    font-family: monospace;
                ">
                    @c
                </td>
            }
        </tr>
    </table>
}

<hr style="margin-bottom: 20px;"/>
<footer style="font-size: 12px; color: gray; text-align:center;">
    &copy; @System.DateTime.Now.Year @Model.AppSettings.Name. All rights reserved.
</footer>

</body>
</html>